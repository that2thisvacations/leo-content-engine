# Public application metadata. Safe to expose in the browser bundle.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase runtime. The project URL and publishable key have safe built-in defaults for the
# LEO read-only RPCs; override them here when moving to another Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only OpenAI runtime for research and episode planning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Server-only YouTube OAuth runtime for channel authorization and publishing.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
